# ─── Backend ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Postgres (соответствует docker-compose.yml)
DATABASE_URL=postgres://cs2:cs2@localhost:5432/cs2_tournament

# Токен для аутентификации MatchZy webhooks. ОБЯЗАТЕЛЬНО смени на свой.
# Этот же токен нужно вписать в gameserver/cfg/matchzy/matchzy.cfg → matchzy_remote_log_header_value
MATCHZY_WEBHOOK_TOKEN=changeme-supersecret

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Default CS2 server (опционально — можно создавать через UI) ────
# DEFAULT_SERVER_NAME=tournament-1
# DEFAULT_SERVER_HOST=192.168.1.50
# DEFAULT_SERVER_PORT=27015
# DEFAULT_SERVER_RCON_PASSWORD=changeme
